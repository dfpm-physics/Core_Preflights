# Never commit these
site/js/config.local.js
*.env
.env*
config.json
INBOX/
_inbox/

# Skill / tooling config — each operator copies config.json.template locally (service keys, DB creds)
.ai/skills/preflight-analyze/config.json
supabase/admin/config.json
supabase/admin/config.*.json
# ^ covers config.owner.json — the sealed DDL-tier credential, kept out of the everyday
#   config on purpose so routine tooling cannot pick it up. See app_schema_bootstrap.sql §7.

# Python virtualenv + caches for admin/analysis tooling (psycopg2, etc.) — keep contained, never commit
.venv/
__pycache__/
*.pyc

# Node modules for the OPTIONAL wiring test harness (tests/app-schema/). The site itself has
# no Node dependency and no build step — see CORE.md §2 and tests/app-schema/README.md. This
# is dev-only tooling; nothing here is served or required to deploy.
tests/app-schema/node_modules/

# Textbook PDFs — too large for git (~968 MB); download from Teams instead
# See textbook-pdfs/README.md for instructions
textbook-pdfs/**/*.pdf
textbook-pdfs/**/*.PDF

# Supabase CLI local state (linked-project ref, version cache) — machine-specific
supabase/.temp/

# Node deps for the OPTIONAL developer test harness (tests/app-schema/). The site itself still
# has no Node dependency and no build step per CORE.md §2 — nothing here is served, imported, or
# needed to deploy. npm always materialises deps per-project, so this folder cannot live
# elsewhere; ignoring it is the fix. tests/app-schema/README.md already assumed this rule.
node_modules/

# macOS
.DS_Store

# Supabase service key files (kept in ~/.claude/skills/ only)
*.service_key
.ai/integrations/custom-gpt/privacy.html

# Pre-change JSON snapshots taken by scripts/ before a live mutation. Local safety artifacts:
# they carry live offering/staff structure and are regenerated on demand, never reviewed in a diff.
_snapshots/

# Artifact SOURCE lives in Supabase Storage, not in git — 46 published artifacts come to ~8 MB
# of .jsx, and committing them would put that in every clone's history permanently. This
# directory is a LOCAL CACHE: populate it with
#     python scripts/artifacts/sync_artifacts.py pull --into _builder/courses --commit
# Only the .jsx is ignored. BUILD-LOG.md and REVIEW-NOTES.json sit beside them and ARE tracked —
# they are the human record of what was built and what was approved, and they diff well.
_builder/courses/*/artifacts/*.jsx

# preflight-kit localizer output — regenerate with `python tools/localize.py`. Never committed;
# localize.py wipes and rewrites it on every run.
_builder/courses/*/build/
_builder/preflight-kit/build/
