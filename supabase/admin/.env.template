# PREP v2 — `app` schema role credentials  (TEMPLATE — copy to `.env` and fill in)
# =============================================================================
# Copy this file to `supabase/admin/.env`. That path is gitignored by the `.env*` pattern;
# THIS template is committed, and must never carry a real value.
#
#   cp supabase/admin/.env.template supabase/admin/.env      # then fill it in
#
# The values come from the course director out-of-band. Never from the repo, never from a
# chat log, never echoed back into a file under the repo tree. See CORE.md §3.
#
# Read by supabase/admin/app_tier_check.py (stdlib parser, no python-dotenv) and by the
# other supabase/admin/*.py tools. Full setup runbook: docs/operations/MACHINE-SETUP.md.
#
# TIERS — see app_schema_bootstrap.sql for the full rationale:
#   OWNER  full DDL inside schema `app`. Build-out only.
#   DML    read/write on `app`, no DDL. The everyday agent role.
#   READ   SELECT only on `app`. Analysis, reporting, exports.
#
# All three carry BYPASSRLS (a direct Postgres connection has no JWT, so RLS would otherwise
# deny every row). The tiering separates WRITE and DDL capability, not row visibility — treat
# all three as sensitive, the READ tier included: it sees every cadet's name and every answer.
# =============================================================================

# The SESSION POOLER host from Supabase → Connect → Session pooler.
# NOT db.<ref>.supabase.co — that is IPv6-only and will not resolve. A connection failure
# here is the single most common setup fault; check this line first.
PREP_DB_HOST=aws-<n>-<region>.pooler.supabase.com
PREP_DB_PORT=5432
PREP_DB_NAME=postgres
PREP_DB_SSLMODE=require
PREP_PROJECT_REF=shzvpmlnqfmzfmuxkowi

# Pooler usernames are '<role>.<project_ref>' — app_tier_check.py assembles them, so put the
# BARE role name here (e.g. `prep_app_dml`, not `prep_app_dml.shzvpmlnqfmzfmuxkowi`).

# OWNER — the only role with DDL on `app`.
# The design is that this role sits sealed (`NOLOGIN`) between coordinated schema changes, so
# holding the credential confers nothing. It has NOT been sealed since 2026-07-23 (verified
# 2026-08-07). Either way the rule is unchanged: you do not run DDL on your own. Schema changes
# go to the course director as migration SQL and are applied as a coordination event (CORE.md §0).
# A tier check that cannot connect as owner is the gate working, not a fault.
# Commenting this pair out is enough to keep the DDL credential out of everyday runs.
PREP_APP_OWNER_ROLE=prep_app_owner
PREP_APP_OWNER_PASSWORD=

# DML — the everyday tier. Used by /lesson-aggregate and the admin write tooling.
PREP_APP_DML_ROLE=prep_app_dml
PREP_APP_DML_PASSWORD=

# READ — SELECT only. Prefer this for anything that does not need to write.
PREP_APP_READ_ROLE=prep_app_read
PREP_APP_READ_PASSWORD=

# =============================================================================
# P0.5 test faculty account — the disposable login for the browser walkthrough.
# =============================================================================
# NOT a Postgres role — this is a Supabase AUTH user, created and confirmed by a human in the
# dashboard (no tooling here can reach schema `auth`; see ROADMAP P0.5). Its app-side rows are
# managed by scripts/test_faculty_account.py, which reads the UID from here; the browser harness
# (tests/browser-harness/) reads all three, so no secret ever appears on a command line.
#
# TEMPORARY. Deleted with the account when prep_app_owner is sealed (ROADMAP P0.2) — deleting the
# auth user in the dashboard cascades the instructors/staff rows away. The UID changes every time
# the account is recreated in the dashboard; update it here when it does.
#
# Optional: omit all three if you are not running the browser harness.
PREP_TEST_FACULTY_EMAIL=
PREP_TEST_FACULTY_PASSWORD=
PREP_TEST_FACULTY_UID=
